{ "name": "pt-interview", "mode": "interview", "lines": [
  { "t": 0, "dur": 2500, "s": "them", "text": "Olá, obrigado por teres vindo." },
  { "t": 3000, "dur": 1500, "s": "me", "text": "Obrigado eu pelo convite." },
  { "t": 5000, "dur": 3000, "s": "them", "text": "Para começar, fala-me um pouco do teu percurso.", "q": true },
  { "t": 9000, "dur": 9000, "s": "me", "text": "Trabalho há seis anos em backend, primeiro na Farfetch e depois numa startup de pagamentos." },
  { "t": 19000, "dur": 700, "s": "them", "text": "Pois." },
  { "t": 20000, "dur": 3500, "s": "them", "text": "Qual foi o projeto de que mais te orgulhas?", "q": true },
  { "t": 31000, "dur": 2500, "s": "them", "text": "E como é que lidaste com, hum" },
  { "t": 35000, "dur": 2000, "s": "them", "text": "os prazos apertados?", "q": true, "joins": true },
  { "t": 42000, "dur": 1500, "s": "them", "text": "Certo, certo." },
  { "t": 44000, "dur": 3000, "s": "them", "text": "Cá usamos sobretudo Java e PostgreSQL." },
  { "t": 48000, "dur": 3000, "s": "them", "text": "Como desenharias um sistema de notificações", "q": true },
  { "t": 56000, "dur": 2000, "s": "them", "text": "Desculpa, podes repetir?", "repeat": true },
  { "t": 61000, "dur": 2500, "s": "them", "text": "Qual é o teu pré-aviso?", "q": true },
  { "t": 65000, "dur": 2000, "s": "them", "text": "Ótimo, da minha parte é tudo." }
] }
