{
  "manifest_version": 3,
  "name": "WhisperBrain for Google Meet",
  "description": "Tells the WhisperBrain app, on this computer only, who is on your Google Meet call and who is speaking, so it can name the voices in your transcript.",
  "version": "0.1.0",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://meet.google.com/*"], "js": ["selectors.js", "reader.js", "content.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "WhisperBrain for Google Meet", "default_popup": "options.html" }
}
